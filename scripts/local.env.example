# Copy to scripts/local.env (git-ignored) and fill in your machines.

# Linux box with apio installed, used by remote-build.sh
BUILD_HOST=user@build-machine
#BUILD_KEY=~/.ssh/some_key      # optional, passed as ssh -i
#BUILD_ROOT=fpga                # directory on the build host, default fpga

# The PYNQ-Z2, used by load-board.sh
BOARD_HOST=xilinx@pynq.local    # or xilinx@192.168.2.99, or xilinx@fe80::…%en8
#BOARD_PW=xilinx
